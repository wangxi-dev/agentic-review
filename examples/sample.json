{
  "name": "agentic-review",
  "exampleOnly": true,
  "nested": {
    "array": [1, 2, 3],
    "object": { "a": true, "b": null, "c": "string" },
    "deep": {
      "level2": {
        "level3": ["x", "y", "z"]
      }
    }
  },
  "reviewModes": ["diff", "commit", "folder"],
  "previews": ["markdown", "html", "png", "jpeg", "webp"],
  "appearance": { "theme": "light", "textSize": "standard" },
  "commentExports": ["agentic-review.comments.json", "agentic-review.comments.md"]
}
