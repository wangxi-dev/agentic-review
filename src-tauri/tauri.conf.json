{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentic-review",
  "version": "0.2.0",
  "identifier": "dev.wangxi.agentic-review",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "agentic-review",
      "width": 1440,
      "height": 940,
      "minWidth": 1000,
      "minHeight": 640
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'self' about:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
